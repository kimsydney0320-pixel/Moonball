rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['kimsydney0320@gmail.com'];
    }
    // one doc per player: {days:{"YYYY-MM-DD":{y,t,at,picks}}, last}
    match /scores/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['days', 'last'])
        && request.resource.data.days is map
        && request.resource.data.last is int;
      allow delete: if (signedIn() && request.auth.uid == uid) || isOwner();
    }
    // private synced stats/streaks/kits
    match /profiles/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // public leaderboard display name ("Jordan L.")
    match /names/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
    }
    // "should this count?" reports: anyone playing can file, only the owner reads/clears
    match /flags/{id} {
      allow create: if signedIn()
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 80
        && request.resource.data.prompt is string && request.resource.data.prompt.size() <= 80;
      allow read, delete: if isOwner();
    }
    // Question Studio: everyone reads, only the owner writes
    match /customPrompts/{id} { allow read: if true; allow write: if isOwner(); }
    match /custom/{id} { allow read: if true; allow write: if isOwner(); }
  }
}
